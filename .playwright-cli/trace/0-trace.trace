{"type":"frame-snapshot","snapshot":{"callId":"call@16","snapshotName":"after@call@16","pageId":"page@fdf586e3fc1d60984645804bd75f7af8","frameId":"frame@dc81fc44d1154954f9eb6c57ac9e380a","frameUrl":"http://localhost:4321/movie/?id=ccc-ea00d1e0-a580-415f-a8cf-f02883d939dc","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://localhost:4321/movie/?id=ccc-ea00d1e0-a580-415f-a8cf-f02883d939dc"}],["META",{"charset":"utf-8"}],["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],["TITLE",{},"Hackflix"],["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],["LINK",{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap","rel":"stylesheet"}],["STYLE",{},"* {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      \n      body {\n        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n        background-color: #141414;\n        color: #ffffff;\n        min-height: 100vh;\n      }"],"\n",["STYLE",{},".header {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 100;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 1rem 3rem;\n    background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);\n  }\n\n  .back-btn {\n    color: #fff;\n    text-decoration: none;\n    font-size: 0.9rem;\n    transition: opacity 0.2s;\n  }\n\n  .back-btn:hover {\n    opacity: 0.7;\n  }\n\n  .logo {\n    font-size: 1.5rem;\n    font-weight: 700;\n    color: #e50914;\n    letter-spacing: 2px;\n  }\n\n  .main {\n    min-height: 100vh;\n  }\n\n  .movie-content {\n    min-height: 100vh;\n    position: relative;\n  }\n\n  .loading {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 80vh;\n    font-size: 1.5rem;\n    color: #b3b3b3;\n  }\n\n  .error {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    height: 80vh;\n    text-align: center;\n  }\n\n  .error h2 {\n    margin-bottom: 0.5rem;\n  }\n\n  .error p {\n    color: #b3b3b3;\n    margin-bottom: 1rem;\n  }\n\n  .movie-backdrop {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 85vh;\n    background-size: cover;\n    background-position: center top;\n  }\n\n  .movie-details {\n    position: relative;\n    z-index: 1;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 80px 4vw 8vw;\n    background: linear-gradient(to right, rgba(20,20,20,0.95) 0%, rgba(20,20,20,0.7) 40%, transparent 100%);\n  }\n\n  .movie-details h1 {\n    font-size: 3.5rem;\n    font-weight: 700;\n    margin-bottom: 0.5rem;\n    max-width: 70%;\n    text-shadow: 2px 2px 8px rgba(0,0,0,0.8);\n  }\n\n  .speakers {\n    font-size: 1.3rem;\n    color: #b3b3b3;\n    margin-bottom: 1rem;\n    max-width: 70%;\n  }\n\n  .meta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin-bottom: 1.5rem;\n    color: #b3b3b3;\n    font-size: 1rem;\n    max-width: 70%;\n  }\n\n  .video-container {\n    width: 70%;\n    max-width: 900px;\n    margin-bottom: 2rem;\n    border-radius: 8px;\n    overflow: hidden;\n    background: #000;\n  }\n\n  .video-container video {\n    width: 100%;\n    display: block;\n  }\n\n  .actions {\n    display: flex;\n    gap: 1rem;\n    margin-bottom: 1.5rem;\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.75rem 1.5rem;\n    border-radius: 4px;\n    text-decoration: none;\n    font-weight: 600;\n    font-size: 1.1rem;\n    transition: background 0.2s;\n  }\n\n  .btn-primary {\n    background: #fff;\n    color: #000;\n  }\n\n  .btn-primary:hover {\n    background: rgba(255,255,255,0.8);\n  }\n\n  .description {\n    font-size: 1.1rem;\n  